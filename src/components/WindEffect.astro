---
// src/components/WindEffect.astro
// Simula viento sobre el trigo:
// - Dos franjas doradas oscilando en diagonal.
// - Partículas de polen flotando con recorridos amplios.
---

<div class="pointer-events-none absolute inset-0 overflow-hidden -z-[12]">

  <!-- CAPA 1: Brisa dorada principal -->
  <div class="absolute bottom-0 left-0 w-full h-[45%] bg-gradient-to-t from-yellow-300/50 via-yellow-300/15 to-transparent animate-wind-sway origin-bottom-left">
  </div>

  <!-- CAPA 2: Segunda brisa con timing distinto -->
  <div class="absolute bottom-0 left-0 w-full h-[35%] bg-gradient-to-t from-amber-500/40 to-transparent animate-wind-sway-slow origin-bottom-right">
  </div>

  <!-- CAPA 3: Partículas de polen flotando en diagonal -->
  <div class="absolute bottom-[15%] left-[10%] w-3 h-3 rounded-full bg-yellow-300/80 animate-pollen-drift blur-[1px]"></div>
  <div class="absolute bottom-[25%] left-[22%] w-4 h-4 rounded-full bg-yellow-200/70 animate-pollen-drift-slow blur-[1px]" style="animation-delay: 2s;"></div>
  <div class="absolute bottom-[12%] left-[35%] w-3 h-3 rounded-full bg-yellow-300/80 animate-pollen-drift blur-[1px]" style="animation-delay: 5s;"></div>
  <div class="absolute bottom-[30%] left-[48%] w-4 h-4 rounded-full bg-yellow-200/70 animate-pollen-drift-slow blur-[1px]" style="animation-delay: 7s;"></div>
  <div class="absolute bottom-[20%] left-[62%] w-3 h-3 rounded-full bg-yellow-300/80 animate-pollen-drift blur-[1px]" style="animation-delay: 1s;"></div>
  <div class="absolute bottom-[18%] left-[75%] w-4 h-4 rounded-full bg-yellow-200/70 animate-pollen-drift-slow blur-[1px]" style="animation-delay: 4s;"></div>
  <div class="absolute bottom-[28%] left-[88%] w-3 h-3 rounded-full bg-yellow-300/80 animate-pollen-drift blur-[1px]" style="animation-delay: 6s;"></div>
  <div class="absolute bottom-[10%] left-[50%] w-5 h-5 rounded-full bg-yellow-100/60 animate-pollen-drift-slow blur-[2px]" style="animation-delay: 8s;"></div>

</div>