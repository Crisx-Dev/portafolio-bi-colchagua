---
// src/components/Hero.astro
// Presentación personal del autor.
// El stack técnico vive en la sección Tecnologías (separada).
import '../styles/global.css';
import { profileData } from '../data/profileData';
import CursorFollower from './CursorFollower.astro';
import MagneticButton from './MagneticButton.astro';
import BackgroundGrid from './BackgroundGrid.astro';
---

<section id="inicio" class="relative min-h-screen flex items-center overflow-hidden
                            bg-slate-50 dark:bg-slate-950 transition-colors duration-500
                            py-24 lg:py-0">

  <!-- Fondo técnico animado -->
  <BackgroundGrid />

  <!-- Cursor glow -->
  <CursorFollower />

  <div class="relative z-10 max-w-6xl mx-auto flex flex-col pt-12 lg:pt-0 pb-20 lg:pb-0">
    <!-- Saludo -->
    <p class="text-sm uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400 mb-4 font-medium">
      {profileData.greeting}
    </p>

    <!-- Nombre (protagonista) -->
    <h1 class="text-6xl md:text-7xl lg:text-8xl font-extrabold tracking-tight
               text-slate-900 dark:text-white mb-6 leading-[0.95]">
      {profileData.name}
    </h1>

    <!-- Rol -->
    <p class="text-2xl md:text-3xl lg:text-4xl font-semibold
              text-emerald-600 dark:text-emerald-400 mb-8 leading-tight">
      {profileData.role}
    </p>

    <!-- Divisor decorativo -->
    <div class="w-20 h-1 bg-gradient-to-r from-emerald-500 to-transparent rounded-full mb-8"></div>

    <!-- Tagline -->
    <p class="text-xl md:text-2xl text-slate-700 dark:text-slate-300 max-w-3xl mb-5 leading-relaxed font-medium">
      {profileData.tagline}
    </p>

    <!-- Descripción -->
    <p class="text-base md:text-lg text-slate-600 dark:text-slate-400 max-w-3xl mb-12 leading-relaxed">
      {profileData.description}
    </p>

    <!-- Botones -->
    <div class="flex flex-wrap gap-3">
      {profileData.links.github && (
        <MagneticButton strength={0.4} radius={90}>
          <a
            href={profileData.links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-7 py-3.5
                   bg-slate-900 dark:bg-white
                   text-white dark:text-slate-900
                   rounded-lg font-semibold text-sm
                   hover:bg-emerald-700 dark:hover:bg-emerald-400
                   transition-colors shadow-lg"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.79-.26.79-.58v-2.02c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.19.7.8.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            Ver GitHub
          </a>
        </MagneticButton>
      )}

      <a
        href="#tecnologias"
        class="w-full sm:w-auto justify-center inline-flex items-center gap-2 px-7 py-3.5
               bg-white dark:bg-slate-800
               text-slate-900 dark:text-white
               border border-slate-200 dark:border-slate-700
               rounded-lg font-semibold text-sm
               hover:border-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400
               transition-colors shadow-sm"
      >
        Ver tecnologías
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>

  </div>

  <!-- Indicador de scroll -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-400 dark:text-slate-500">
    <span class="text-[10px] uppercase tracking-[0.3em] font-medium">Scroll</span>
    <div class="w-px h-12 bg-gradient-to-b from-slate-400/70 to-transparent"></div>
  </div>

</section>