---
// src/components/BackgroundGrid.astro
// Fondo técnico animado: grid + gradientes radiales + líneas verticales.
// Solo decorativo. No interfiere con el contenido.
---

<div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">

  <!-- Capa 1: Gradiente base -->
  <div class="absolute inset-0
              bg-gradient-to-br
              from-slate-50 via-white to-slate-50
              dark:from-slate-950 dark:via-slate-950 dark:to-slate-900"></div>

  <!-- Capa 2: Grid que se desplaza lentamente -->
  <div class="absolute inset-0 opacity-[0.35] dark:opacity-[0.15]
              bg-[linear-gradient(to_right,#64748b_1px,transparent_1px),linear-gradient(to_bottom,#64748b_1px,transparent_1px)]
              bg-[size:48px_48px]
              animate-grid-drift"></div>

  <!-- Capa 3: Halos de color radial en esquinas -->
  <div class="absolute -top-40 -left-40 w-[500px] h-[500px] rounded-full
              bg-emerald-400/10 dark:bg-emerald-500/10
              blur-[100px]"></div>
  <div class="absolute -bottom-40 -right-40 w-[500px] h-[500px] rounded-full
              bg-sky-400/10 dark:bg-sky-500/10
              blur-[100px]"></div>

  <!-- Capa 4: Líneas verticales decorativas (tipo columnas de datos) -->
  <div class="absolute inset-0 opacity-20 dark:opacity-10">
    <div class="absolute top-0 h-full w-px bg-gradient-to-b from-transparent via-emerald-500/40 to-transparent"
         style="left: 15%;"></div>
    <div class="absolute top-0 h-full w-px bg-gradient-to-b from-transparent via-emerald-500/30 to-transparent"
         style="left: 35%;"></div>
    <div class="absolute top-0 h-full w-px bg-gradient-to-b from-transparent via-sky-500/40 to-transparent"
         style="left: 65%;"></div>
    <div class="absolute top-0 h-full w-px bg-gradient-to-b from-transparent via-sky-500/30 to-transparent"
         style="left: 85%;"></div>
  </div>

</div>