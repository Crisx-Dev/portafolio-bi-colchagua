---
// src/components/Sidebar.astro
// Índice minimalista tipo "lista de conversaciones" (ChatGPT/Gemini).
// Fijo a la derecha, flotante, sin decoración. Oculto en móvil.
// Resalta la sección activa con una barrita lateral.
---

<!-- Índice flotante: oculto en móvil, visible desde md -->
<nav
  id="section-index"
  aria-label="Índice del portafolio"
  class="hidden md:flex flex-col gap-1
         fixed top-1/2 -translate-y-1/2 right-6 lg:right-10
         z-40
         max-w-[180px]"
>
  <p class="text-[10px] uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500 font-semibold mb-2 pl-3">
    Índice
  </p>

  <a href="#inicio" data-section="inicio"
     class="index-link group flex items-center gap-2 px-3 py-1.5 rounded-md
            text-xs text-slate-500 dark:text-slate-400
            hover:text-slate-900 dark:hover:text-white
            hover:bg-slate-100/70 dark:hover:bg-slate-800/50
            transition-all">
    <span class="index-bar w-0.5 h-4 bg-transparent rounded-full transition-all"></span>
    <span class="truncate">Inicio</span>
  </a>

    <a href="#tecnologias" data-section="tecnologias"
     class="index-link group flex items-center gap-2 px-3 py-1.5 rounded-md
            text-xs text-slate-500 dark:text-slate-400
            hover:text-slate-900 dark:hover:text-white
            hover:bg-slate-100/70 dark:hover:bg-slate-800/50
            transition-all">
    <span class="index-bar w-0.5 h-4 bg-transparent rounded-full transition-all"></span>
    <span class="truncate">Tecnologías</span>
  </a>
    <a href="#proyectos" data-section="proyectos"
     class="index-link group flex items-center gap-2 px-3 py-1.5 rounded-md
            text-xs text-slate-500 dark:text-slate-400
            hover:text-slate-900 dark:hover:text-white
            hover:bg-slate-100/70 dark:hover:bg-slate-800/50
            transition-all">
    <span class="index-bar w-0.5 h-4 bg-transparent rounded-full transition-all"></span>
    <span class="truncate">Proyectos</span>
  </a>
</nav>

<style>
  /* Estado activo: barra lateral visible + texto en negrita + color destacado */
  .index-link.active {
    color: rgb(5 150 105);
    font-weight: 600;
  }
  :global(.dark) .index-link.active {
    color: rgb(52 211 153);
  }
  .index-link.active .index-bar {
    background-color: rgb(16 185 129);
    height: 1rem;
  }
</style>

<script>
  (() => {
    // =====================================================
    // HIGHLIGHT AUTOMÁTICO DE LA SECCIÓN ACTIVA
    // =====================================================
    const links = document.querySelectorAll<HTMLAnchorElement>('.index-link');
    const sections = Array.from(links)
      .map((link) => {
        const id = link.dataset.section;
        return id ? document.getElementById(id) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    if (sections.length > 0 && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              links.forEach((link) => {
                link.classList.toggle('active', link.dataset.section === id);
              });
            }
          });
        },
        {
          // Se considera activa cuando la sección cruza el centro de la pantalla
          rootMargin: '-40% 0px -55% 0px',
          threshold: 0,
        }
      );
      sections.forEach((section) => observer.observe(section));
    }
  })();
</script>