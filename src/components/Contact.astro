---
// src/components/Contact.astro
// Sección de contacto con reCAPTCHA v3 y feedback visual al enviar.
import { contactData } from '../data/contactData';

const { heading, channels, form } = contactData;

const RECAPTCHA_SITE_KEY = "6LfeR-wtAAAAACz8UREX4YrLI8vVrcW-rQgG7szP";
---

<section id="contacto" class="reveal relative py-24 lg:py-32
                              bg-slate-50 dark:bg-slate-950
                              transition-colors duration-500">

  <div class="absolute top-0 left-0 w-full h-px
              bg-gradient-to-r from-transparent via-slate-200 dark:via-slate-800 to-transparent"></div>

  <div class="max-w-5xl mx-auto px-6 lg:px-12">

    <!-- Encabezado -->
    <div class="max-w-3xl mb-12">
      <p class="text-xs uppercase tracking-[0.3em] text-emerald-600 dark:text-emerald-400 mb-4 font-semibold">
        Contacto
      </p>
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight
                 text-slate-900 dark:text-white mb-6 leading-[1.15]">
        {heading.title}
      </h2>
      <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
        {heading.description}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">

      <!-- Canales de contacto -->
      <div class="lg:col-span-4 flex flex-col gap-4">
        {channels.map((channel) => (
          <a
            href={channel.href}
            target={channel.icon === "github" ? "_blank" : undefined}
            rel={channel.icon === "github" ? "noopener noreferrer" : undefined}
            class="group flex items-center gap-4 p-5 rounded-xl
                   bg-white dark:bg-slate-900
                   border border-slate-200 dark:border-slate-800
                   hover:border-emerald-400 dark:hover:border-emerald-600
                   hover:shadow-lg
                   transition-all"
          >
            <div class="shrink-0 w-10 h-10 rounded-lg
                        bg-emerald-50 dark:bg-emerald-950/40
                        flex items-center justify-center
                        group-hover:bg-emerald-500
                        transition-colors">
              {channel.icon === "mail" ? (
                <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400 group-hover:text-white transition-colors"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              ) : (
                <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400 group-hover:text-white transition-colors"
                     fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.79-.26.79-.58v-2.02c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.19.7.8.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/>
                </svg>
              )}
            </div>
            <div class="min-w-0">
              <p class="text-[10px] uppercase tracking-[0.15em] text-slate-500 dark:text-slate-400 font-semibold mb-1">
                {channel.label}
              </p>
              <p class="text-sm font-medium text-slate-900 dark:text-white truncate">
                {channel.value}
              </p>
            </div>
          </a>
        ))}
      </div>

      <!-- Formulario -->
      <div class="lg:col-span-8">
        <form
          id="contact-form"
          action={form.endpoint}
          method="POST"
          class="relative p-6 lg:p-8 rounded-2xl
                 bg-white dark:bg-slate-900
                 border border-slate-200 dark:border-slate-800
                 shadow-sm
                 transition-all"
        >
          <!-- Campo oculto para el token de reCAPTCHA -->
          <input type="hidden" name="g-recaptcha-response" id="g-recaptcha-response" />

          <!-- Contenido del formulario (se oculta al enviar) -->
          <div id="form-fields">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">

              <div>
                <label for="name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-2">
                  Nombre
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-2.5 rounded-lg
                         bg-slate-50 dark:bg-slate-800/50
                         border border-slate-200 dark:border-slate-700
                         text-sm text-slate-900 dark:text-white
                         placeholder:text-slate-400 dark:placeholder:text-slate-500
                         focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500
                         transition-all"
                  placeholder="Tu nombre"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-2">
                  Email
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-2.5 rounded-lg
                         bg-slate-50 dark:bg-slate-800/50
                         border border-slate-200 dark:border-slate-700
                         text-sm text-slate-900 dark:text-white
                         placeholder:text-slate-400 dark:placeholder:text-slate-500
                         focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500
                         transition-all"
                  placeholder="tu@email.com"
                />
              </div>

            </div>

            <div class="mb-5">
              <label for="message" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-2">
                Mensaje
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows={5}
                class="w-full px-4 py-2.5 rounded-lg resize-none
                       bg-slate-50 dark:bg-slate-800/50
                       border border-slate-200 dark:border-slate-700
                       text-sm text-slate-900 dark:text-white
                       placeholder:text-slate-400 dark:placeholder:text-slate-500
                       focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500
                       transition-all"
                placeholder="Cuéntame sobre tu proyecto o consulta..."
              ></textarea>
            </div>

            <div class="flex items-center justify-between gap-4 flex-wrap">
              <p class="text-xs text-slate-500 dark:text-slate-400">
                Recibiré tu mensaje directo a mi correo.
              </p>
              <button
                type="submit"
                id="submit-button"
                class="inline-flex items-center gap-2 px-6 py-3
                       bg-slate-900 dark:bg-white
                       text-white dark:text-slate-900
                       rounded-lg font-semibold text-sm
                       hover:bg-emerald-700 dark:hover:bg-emerald-400
                       transition-all shadow-lg
                       focus:outline-none focus:ring-2 focus:ring-emerald-500/50
                       disabled:opacity-60 disabled:cursor-not-allowed"
              >
                <span id="submit-text">Enviar mensaje</span>
                <svg id="submit-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </button>
            </div>
          </div>

          <!-- Estado: Enviando (oculto por defecto) -->
          <div id="state-loading" class="hidden flex-col items-center justify-center gap-4 py-8 text-center">
            <div class="relative w-12 h-12">
              <div class="absolute inset-0 rounded-full border-4 border-slate-200 dark:border-slate-700"></div>
              <div class="absolute inset-0 rounded-full border-4 border-emerald-500 border-t-transparent animate-spin"></div>
            </div>
            <p class="text-sm font-medium text-slate-700 dark:text-slate-300">
              Enviando mensaje...
            </p>
          </div>

          <!-- Estado: Éxito (oculto por defecto) -->
          <div id="state-success" class="hidden flex-col items-center justify-center gap-4 py-10 text-center">
            <div class="relative">
              <div class="w-16 h-16 rounded-full bg-emerald-100 dark:bg-emerald-950/50
                          flex items-center justify-center
                          animate-[scaleIn_0.4s_ease-out]">
                <svg class="w-8 h-8 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <span class="absolute inset-0 rounded-full bg-emerald-400/30 animate-ping"></span>
            </div>
            <div>
              <p class="text-lg font-bold text-slate-900 dark:text-white mb-1">
                ¡Mensaje enviado!
              </p>
              <p class="text-sm text-slate-600 dark:text-slate-400">
                Gracias por escribirme. Te responderé lo antes posible.
              </p>
            </div>
            <button
              type="button"
              id="reset-form"
              class="mt-2 text-xs font-semibold text-emerald-600 dark:text-emerald-400
                     hover:text-emerald-700 dark:hover:text-emerald-300
                     transition-colors"
            >
              Enviar otro mensaje
            </button>
          </div>

          <!-- Estado: Error (oculto por defecto) -->
          <div id="state-error" class="hidden flex-col items-center justify-center gap-4 py-10 text-center">
            <div class="w-16 h-16 rounded-full bg-red-100 dark:bg-red-950/50
                        flex items-center justify-center
                        animate-[scaleIn_0.4s_ease-out]">
              <svg class="w-8 h-8 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <p class="text-lg font-bold text-slate-900 dark:text-white mb-1">
                Algo salió mal
              </p>
              <p class="text-sm text-slate-600 dark:text-slate-400">
                No pudimos enviar tu mensaje. Inténtalo nuevamente o escríbeme directo al correo.
              </p>
            </div>
            <button
              type="button"
              id="retry-form"
              class="mt-2 text-xs font-semibold text-emerald-600 dark:text-emerald-400
                     hover:text-emerald-700 dark:hover:text-emerald-300
                     transition-colors"
            >
              Reintentar
            </button>
          </div>

        </form>
      </div>

    </div>

  </div>
</section>

<style>
  @keyframes scaleIn {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>

<!-- reCAPTCHA v3 -->
<script src={`https://www.google.com/recaptcha/api.js?render=${RECAPTCHA_SITE_KEY}`} is:inline></script>

<script define:vars={{ RECAPTCHA_SITE_KEY }} is:inline>
  (() => {
    const form = document.getElementById('contact-form');
    const submitButton = document.getElementById('submit-button');
    const submitText = document.getElementById('submit-text');
    const recaptchaResponse = document.getElementById('g-recaptcha-response');

    const formFields = document.getElementById('form-fields');
    const stateLoading = document.getElementById('state-loading');
    const stateSuccess = document.getElementById('state-success');
    const stateError = document.getElementById('state-error');

    const resetBtn = document.getElementById('reset-form');
    const retryBtn = document.getElementById('retry-form');

    if (!form) return;

    // Función para mostrar un estado y ocultar los otros
    const showState = (state) => {
      formFields.classList.add('hidden');
      stateLoading.classList.add('hidden');
      stateLoading.classList.remove('flex');
      stateSuccess.classList.add('hidden');
      stateSuccess.classList.remove('flex');
      stateError.classList.add('hidden');
      stateError.classList.remove('flex');

      if (state === 'form') {
        formFields.classList.remove('hidden');
      } else if (state === 'loading') {
        stateLoading.classList.remove('hidden');
        stateLoading.classList.add('flex');
      } else if (state === 'success') {
        stateSuccess.classList.remove('hidden');
        stateSuccess.classList.add('flex');
      } else if (state === 'error') {
        stateError.classList.remove('hidden');
        stateError.classList.add('flex');
      }
    };

    // Interceptar envío del formulario
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      submitButton.disabled = true;
      if (submitText) submitText.textContent = 'Enviando...';

      showState('loading');

      // Ejecutar reCAPTCHA v3
      grecaptcha.ready(() => {
        grecaptcha.execute(RECAPTCHA_SITE_KEY, { action: 'submit' }).then((token) => {
          recaptchaResponse.value = token;

          // Enviar con fetch para evitar redirección
          const formData = new FormData(form);
          fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { 'Accept': 'application/json' },
          })
            .then((response) => {
              if (response.ok) {
                showState('success');
                form.reset();
              } else {
                showState('error');
              }
            })
            .catch(() => {
              showState('error');
            })
            .finally(() => {
              submitButton.disabled = false;
              if (submitText) submitText.textContent = 'Enviar mensaje';
            });
        }).catch(() => {
          showState('error');
          submitButton.disabled = false;
          if (submitText) submitText.textContent = 'Enviar mensaje';
        });
      });
    });

    // Botón "Enviar otro mensaje" (desde éxito)
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        showState('form');
        form.reset();
      });
    }

    // Botón "Reintentar" (desde error)
    if (retryBtn) {
      retryBtn.addEventListener('click', () => {
        showState('form');
      });
    }
  })();
</script>