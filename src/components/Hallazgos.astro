---
// src/components/Hallazgos.astro
// Sección de hallazgos del caso Colchagua.
import {
  findingsData,
  workersByComuna,
  fireByComuna,
  frostByComuna,
} from '../data/findingsData';
import WorkersBarChart from './charts/WorkersBarChart.tsx';
import FireHaChart from './charts/FireHaChart.tsx';
import FrostChart from './charts/FrostChart.tsx';

const [finding1, finding2] = findingsData;
---

<section id="hallazgos" class="reveal relative py-24 lg:py-32
                                bg-white dark:bg-slate-900
                                transition-colors duration-500">

  <div class="absolute top-0 left-0 w-full h-px
              bg-gradient-to-r from-transparent via-slate-200 dark:via-slate-800 to-transparent"></div>

  <div class="max-w-6xl mx-auto px-6 lg:px-12">

    <!-- Encabezado -->
    <div class="max-w-3xl mb-16">
      <p class="text-xs uppercase tracking-[0.3em] text-emerald-600 dark:text-emerald-400 mb-4 font-semibold">
        Hallazgos
      </p>
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight
                 text-slate-900 dark:text-white mb-6 leading-[1.15]">
        Lo que revelaron los datos
      </h2>
      <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
        Seis hallazgos clave sobre la vulnerabilidad territorial de Colchagua. Cada uno respaldado por el análisis cruzado de fuentes oficiales y visualizado con datos reales.
      </p>
    </div>

    <!-- ============================================================
         HALLAZGO 01
         ============================================================ -->
    <article class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">

      <div class="lg:col-span-5 flex flex-col justify-center">
        <div class="inline-flex items-center gap-2 mb-6">
          <span class="w-6 h-px bg-emerald-500"></span>
          <p class="text-[10px] uppercase tracking-[0.2em] text-emerald-600 dark:text-emerald-400 font-semibold">
            Hallazgo 01
          </p>
        </div>
        <h3 class="text-2xl md:text-3xl font-bold tracking-tight
                   text-slate-900 dark:text-white mb-6 leading-tight">
          {finding1.title}
        </h3>
        <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed mb-8">
          {finding1.description}
        </p>
        <div class="p-6 rounded-2xl
                    bg-slate-50 dark:bg-slate-950/50
                    border-l-4 border-emerald-500">
          <p class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white leading-none mb-2">
            {finding1.highlight.value}
          </p>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-snug">
            {finding1.highlight.label}
          </p>
        </div>
        {finding1.footnote && (
          <p class="mt-4 text-xs text-slate-400 dark:text-slate-500 italic">
            {finding1.footnote}
          </p>
        )}
      </div>

      <div class="lg:col-span-7 flex items-center min-w-0">
        <div class="w-full min-w-0 p-6 lg:p-8 rounded-2xl
                    bg-white dark:bg-slate-900
                    border border-slate-200 dark:border-slate-800
                    shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 font-semibold mb-6">
            Trabajadores agrícolas por comuna · 2021
          </p>
          <WorkersBarChart data={workersByComuna} client:only="react" />
        </div>
      </div>

    </article>

    <!-- ============================================================
         SEPARADOR + CITA PUENTE
         ============================================================ -->
    <div class="my-20 lg:my-24">

      <!-- Línea con punto central -->
      <div class="flex items-center gap-4 mb-10">
        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-slate-300 dark:via-slate-700 to-transparent"></div>
        <div class="relative">
          <span class="block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="absolute inset-0 w-2 h-2 rounded-full bg-emerald-500 animate-ping opacity-75"></span>
        </div>
        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-slate-300 dark:via-slate-700 to-transparent"></div>
      </div>

      <!-- Cita puente -->
      <blockquote class="max-w-3xl mx-auto text-center">
        <p class="text-xl md:text-2xl font-medium italic text-slate-700 dark:text-slate-300 leading-relaxed">
          "Dos comunas concentran casi la mitad del empleo agrícola provincial. Cuando el fuego o la helada golpean ahí, arrastran a toda la economía local."
        </p>
      </blockquote>

    </div>

    <!-- ============================================================
         HALLAZGO 02
         ============================================================ -->
    <article>

      <!-- Fila superior: texto + KPI -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 mb-10">

        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 mb-6">
            <span class="w-6 h-px bg-emerald-500"></span>
            <p class="text-[10px] uppercase tracking-[0.2em] text-emerald-600 dark:text-emerald-400 font-semibold">
              Hallazgo 02
            </p>
          </div>
          <h3 class="text-2xl md:text-3xl font-bold tracking-tight
                     text-slate-900 dark:text-white mb-6 leading-tight">
            {finding2.title}
          </h3>
          <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
            {finding2.description}
          </p>
        </div>

        <div class="lg:col-span-5 flex items-center">
          <div class="w-full p-6 rounded-2xl
                      bg-slate-50 dark:bg-slate-950/50
                      border-l-4 border-emerald-500">
            <p class="text-5xl md:text-6xl font-extrabold text-slate-900 dark:text-white leading-none mb-3">
              {finding2.highlight.value}
            </p>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-snug">
              {finding2.highlight.label}
            </p>
          </div>
        </div>

      </div>

      <!-- Fila inferior: 2 gráficos en fila -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <div class="w-full min-w-0 p-6 lg:p-8 rounded-2xl
                    bg-white dark:bg-slate-900
                    border border-slate-200 dark:border-slate-800
                    shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 font-semibold mb-6">
            Superficie quemada · 2021
          </p>
          <FireHaChart data={fireByComuna} client:only="react" />
        </div>

        <div class="w-full min-w-0 p-6 lg:p-8 rounded-2xl
                    bg-white dark:bg-slate-900
                    border border-slate-200 dark:border-slate-800
                    shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 font-semibold mb-6">
            Días promedio de helada · 2018-2021
          </p>
          <FrostChart data={frostByComuna} client:only="react" />
        </div>

      </div>

      {finding2.footnote && (
        <p class="mt-6 text-xs text-slate-400 dark:text-slate-500 italic">
          {finding2.footnote}
        </p>
      )}

    </article>

    <!-- Próximos hallazgos se agregarán aquí -->

  </div>
</section>