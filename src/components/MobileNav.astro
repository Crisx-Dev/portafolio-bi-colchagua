---
// src/components/MobileNav.astro
// Menú flotante para móvil: botón + drawer deslizable con el índice.
import type { NavLink } from '../data/navigation';

interface Props {
  links?: NavLink[];
}

const { links = [] } = Astro.props;
---

<!-- Botón flotante -->
<button
  id="mobile-nav-toggle"
  aria-label="Abrir índice"
  aria-expanded="false"
  class="md:hidden fixed top-4 left-4 z-[60]
         inline-flex items-center gap-2 px-3 py-2.5 rounded-full
         bg-white/90 dark:bg-slate-900/90 backdrop-blur-md
         border border-slate-200 dark:border-slate-700
         shadow-lg hover:shadow-xl
         transition-all duration-300"
>
  <svg class="w-4 h-4 text-slate-700 dark:text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
  </svg>
  <span class="text-xs font-semibold text-slate-700 dark:text-slate-200">Índice</span>
</button>

<!-- Overlay oscuro -->
<div
  id="mobile-nav-overlay"
  class="md:hidden fixed inset-0 z-[55] bg-slate-950/60 backdrop-blur-sm
         opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<!-- Panel deslizable -->
<aside
  id="mobile-nav-panel"
  class="md:hidden fixed top-0 left-0 z-[58] h-full w-72
         bg-white dark:bg-slate-900
         border-r border-slate-200 dark:border-slate-800
         shadow-2xl
         -translate-x-full
         transition-transform duration-300 ease-out
         flex flex-col"
  aria-label="Índice de navegación móvil"
>
  <!-- Botón cerrar -->
  <div class="flex items-center justify-end px-5 pt-5 pb-3">
    <button
      id="mobile-nav-close"
      aria-label="Cerrar índice"
      class="w-8 h-8 rounded-full
             flex items-center justify-center
             text-slate-500 dark:text-slate-400
             hover:bg-slate-100 dark:hover:bg-slate-800
             transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Título -->
  <div class="px-5 pb-3">
    <p class="text-[10px] uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500 font-semibold">
      Índice
    </p>
  </div>

  <!-- Lista de links -->
  <nav class="flex-1 overflow-y-auto px-3 py-2" aria-label="Secciones">
    <ul class="space-y-0.5">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            data-mobile-link
            class="flex items-center gap-2.5 px-3 py-2.5 rounded-md
                   text-sm text-slate-600 dark:text-slate-300
                   hover:bg-slate-100 dark:hover:bg-slate-800/70
                   transition-colors"
          >
            <span class="w-1 h-4 rounded-full bg-transparent transition-colors"></span>
            <span>{link.label}</span>
          </a>

          {link.subLinks && link.subLinks.length > 0 && (
            <ul class="ml-5 mt-0.5 space-y-0.5">
              {link.subLinks.map((subLink) => (
                <li>
                  <a
                    href={subLink.href}
                    data-mobile-link
                    class="flex items-center gap-2.5 px-3 py-2 rounded-md
                           text-xs font-mono text-slate-500 dark:text-slate-400
                           hover:bg-slate-100 dark:hover:bg-slate-800/70
                           transition-colors"
                  >
                    <span class="w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                    <span>{subLink.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</aside>

<style>
  #mobile-nav-toggle.hidden-by-drawer {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  (() => {
    const toggle = document.getElementById('mobile-nav-toggle');
    const panel = document.getElementById('mobile-nav-panel');
    const overlay = document.getElementById('mobile-nav-overlay');
    const closeBtn = document.getElementById('mobile-nav-close');

    const open = () => {
      panel?.classList.remove('-translate-x-full');
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
      toggle?.classList.add('hidden-by-drawer');
      toggle?.setAttribute('aria-expanded', 'true');
    };

    const close = () => {
      panel?.classList.add('-translate-x-full');
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      toggle?.classList.remove('hidden-by-drawer');
      toggle?.setAttribute('aria-expanded', 'false');
    };

    toggle?.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    overlay?.addEventListener('click', close);

    // Cerrar al hacer clic en cualquier link
    document.querySelectorAll('[data-mobile-link]').forEach((link) => {
      link.addEventListener('click', close);
    });
  })();
</script>